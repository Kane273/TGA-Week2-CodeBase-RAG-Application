# Default local development configuration: persistent and no API key.
MAX_CITATION_REPAIR_ATTEMPTS=3
GITHUB_CLONE_TIMEOUT_SECONDS=180
DOCUMENT_PARSER_PROVIDER=local
VECTOR_STORE_PROVIDER=chroma
INDEXING_WORKER_MODE=local
GRAPH_CHECKPOINT_BACKEND=memory
RATE_LIMIT_PER_MINUTE=120
MALWARE_SCAN_ENABLED=false
TEMPORARY_UPLOAD_TTL_HOURS=72
GITHUB_MAX_CHECKOUT_BYTES=250000000
GITHUB_MAX_CHECKOUT_FILES=10000
MAX_RETRIEVAL_HOPS=3
MAX_RETRIEVAL_TOOL_CALLS=6
MULTI_QUERY_COUNT=3
PARENT_CONTEXT_CHUNKS=2
RETRIEVAL_CANDIDATE_K=24
RERANK_CANDIDATE_K=24
RETRIEVAL_PARALLELISM=3
INDEX_BATCH_SIZE=64
CONTEXT_MAX_CHARACTERS=48000
QUERY_PLAN_CACHE_TTL_SECONDS=900
EMBEDDING_CACHE_ENABLED=true
MAX_CONCURRENT_MODEL_REQUESTS=2

# Optional hosted tracing/evaluation. Disabled keeps all traces local.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=engineering-codebase-rag
# LANGSMITH_API_KEY=inject-from-a-secret-manager
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=

# Optional managed Pinecone production configuration (requires a secret).
# VECTOR_STORE_PROVIDER=pinecone
# PINECONE_API_KEY=store-this-in-your-secret-manager
# PINECONE_INDEX_HOST=https://your-index-host.svc.pinecone.io
# PINECONE_INDEX_NAME=codebase-rag
# PINECONE_DIMENSION=768
