# No-key production profile uses a private, self-hosted Chroma service.
VECTOR_STORE_PROVIDER=chroma
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false
INDEXING_WORKER_MODE=redis
GRAPH_CHECKPOINT_BACKEND=postgres
GRAPH_CHECKPOINT_DATABASE_URL=
RATE_LIMIT_PER_MINUTE=120
MALWARE_SCAN_ENABLED=true
TEMPORARY_UPLOAD_TTL_HOURS=72
GITHUB_MAX_CHECKOUT_BYTES=250000000
GITHUB_MAX_CHECKOUT_FILES=10000
MAX_RETRIEVAL_HOPS=3
MAX_RETRIEVAL_TOOL_CALLS=6
MULTI_QUERY_COUNT=3
PARENT_CONTEXT_CHUNKS=2
RETRIEVAL_CANDIDATE_K=24
RERANK_CANDIDATE_K=24
RETRIEVAL_PARALLELISM=3
INDEX_BATCH_SIZE=64
CONTEXT_MAX_CHARACTERS=48000
QUERY_PLAN_CACHE_TTL_SECONDS=900
EMBEDDING_CACHE_ENABLED=true
MAX_CONCURRENT_MODEL_REQUESTS=2
CLAMAV_HOST=clamav

AUTH_ENABLED=true
DATABASE_URL=
REDIS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=codebase-rag
OIDC_JWKS_URL=
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional hosted LangChain/LangGraph tracing; leave disabled for no-key operation.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=engineering-codebase-rag-production
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=

# Optional managed Pinecone alternative; requires a secret API key.
# VECTOR_STORE_PROVIDER=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX_HOST=
